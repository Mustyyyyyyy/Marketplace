# Copy to .env.local for local dev, or set in Vercel/Render dashboard for prod.

# Optional override for server-side requests.
# Production backend: https://marketplace-backend-sable.vercel.app
# In local development: http://localhost:4000
BACKEND_INTERNAL_URL=http://localhost:4000

# Optional public API override. Browser requests normally use the same-origin
# /api/backend/* rewrite configured by Next.js and Vercel.
# Production backend: https://marketplace-backend-sable.vercel.app
NEXT_PUBLIC_API_BASE=http://localhost:4000

# Optional Firebase web app config (only needed for Google sign-in).
# Get these from Firebase Console → Project Settings → Your apps → Web app.
# If you leave these blank, the Google button falls back to the backend
# server-side OAuth flow (set GOOGLE_CLIENT_ID/SECRET in the backend env).
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBxHUDdWNBi9_TxRH4FbSUbAKROR4jBQGU
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=marrketplace-77848.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=marrketplace-77848
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=marrketplace-77848.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=819451392310
NEXT_PUBLIC_FIREBASE_APP_ID=1:819451392310:web:43b6e2519cab8861580397
