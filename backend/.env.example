# Database
DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"

# Auth
JWT_SECRET="generate-a-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
TWOFA_ISSUER="TaskSphere"

# Server
PORT=4000
NODE_ENV=development
# Production frontend: https://marketplace-beryl-one.vercel.app
CORS_ORIGIN="*"
UPLOAD_DIR="./uploads"

# Public URL used in emails (verification, password reset)
# Production frontend: https://marketplace-beryl-one.vercel.app
PUBLIC_BASE_URL="http://localhost:3000"

# SMTP — fill in your SMTP credentials. Gmail App Passwords work fine.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@example.com"
SMTP_PASS="your-app-password"
SMTP_FROM="no-reply@yourdomain.com"
SMTP_FROM_NAME="TaskSphere"

# SMS (optional)
SMS_PROVIDER=console

# Firebase (optional — only needed for Google sign-in via Firebase Client SDK)
# Get these from https://console.firebase.google.com → Project Settings → Service accounts / Web app
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Paste the full private key, including BEGIN/END lines, with literal \n for newlines
FIREBASE_PRIVATE_KEY=""
# Web-side public Firebase config. The web app's Google button uses the
# Firebase client SDK when these are set. If they're empty, the backend's
# server-side Google OAuth flow (GOOGLE_CLIENT_ID below) is used instead.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""

# Google OAuth (server-side flow) — alternative to the Firebase client SDK.
# Get these from https://console.cloud.google.com → APIs & Services → Credentials → Create OAuth 2.0 Client ID
# Type: Web application. Authorized redirect URI: <PUBLIC_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Override only if your callback URL is different from <PUBLIC_BASE_URL>/api/auth/google/callback
GOOGLE_REDIRECT_URI=""

# ---------- Admin bootstrap (one-time, optional) ----------
# If set, the backend creates a first admin on startup if none exist.
# Leave ADMIN_BOOTSTRAP_PASSWORD blank to have one generated and printed to logs.
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""

# Cloudinary — required for image uploads (avatars, KYC, portfolio, task media, chat attachments)
# Get these from https://console.cloudinary.com/ → Settings → API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="tasksphere"

# Flutterwave — required for checkout, escrow tracking, and local bank payouts
FLW_SECRET_KEY=""
FLW_SECRET_HASH=""
# Register https://<backend-domain>/api/payments/webhook in Flutterwave Dashboard.
# Run `npm run prisma:deploy` from a trusted shell with DATABASE_URL set.
